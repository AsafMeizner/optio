# Optional offline inputs; defaults retain the upstream base images.
ARG NODE_SLIM_IMAGE=node:26.12.1-bookworm-slim@sha256:28147155d47dc31abe0a46e0d12b59b2fb3d0a2dcc5dc65fce76a074180b16fe
ARG NODE_IMAGE=
ARG API_TOOLCHAIN_IMAGE=

# Replaced with a directory or image containing store/ and pnpm.tgz.
FROM scratch AS pnpm-offline

# ---- MCP bridge build stage ----
# The same bundle the agent images bake in (images/base.Dockerfile): the
# controller MCP (/opt/optio/controller-mcp.js) and the REST bridge
# (/opt/optio/mcp-bridge.js). An Ask Optio turn that runs in this pod
# (OPTIO_ASSISTANT_PLACEMENT=api-pod) gets the same .mcp.json as a turn in an
# agent pod, so the scripts it names have to be here too.
FROM ${NODE_SLIM_IMAGE} AS bridge
ARG PNPM_OFFLINE=0
RUN --mount=type=bind,from=pnpm-offline,target=/pnpm-offline \
    if [ "$PNPM_OFFLINE" = "1" ]; then \
      mkdir -p /opt/pnpm \
      && tar -xzf /pnpm-offline/pnpm.tgz -C /opt/pnpm --strip-components=2 \
      && ln -s /opt/pnpm/bin/pnpm.cjs /usr/local/bin/pnpm \
      && ln -s /opt/pnpm/bin/pnpx.cjs /usr/local/bin/pnpx; \
    else npm install -g pnpm@10.34.8; fi
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/mcp-bridge/ packages/mcp-bridge/
RUN --mount=type=bind,from=pnpm-offline,target=/pnpm-offline,rw \
    if [ "$PNPM_OFFLINE" = "1" ]; then \
      pnpm install --frozen-lockfile --ignore-scripts --filter @optio/mcp-bridge \
        --offline --store-dir /pnpm-offline/store; \
    else pnpm install --frozen-lockfile --ignore-scripts --filter @optio/mcp-bridge; fi \
    && pnpm --filter @optio/mcp-bridge build

# ---- Dependencies stage ----
FROM ${NODE_IMAGE:-${NODE_SLIM_IMAGE}} AS deps

ARG PNPM_OFFLINE=0
RUN --mount=type=bind,from=pnpm-offline,target=/pnpm-offline \
    if [ "$PNPM_OFFLINE" = "1" ]; then \
      mkdir -p /opt/pnpm \
      && tar -xzf /pnpm-offline/pnpm.tgz -C /opt/pnpm --strip-components=2 \
      && ln -s /opt/pnpm/bin/pnpm.cjs /usr/local/bin/pnpm \
      && ln -s /opt/pnpm/bin/pnpx.cjs /usr/local/bin/pnpx; \
    else npm install -g pnpm@10.34.8; fi

WORKDIR /app

# Copy workspace config
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./

# Copy package.json for ALL workspace packages (pnpm needs full workspace graph)
COPY apps/api/package.json apps/api/tsconfig.json apps/api/drizzle.config.ts apps/api/
COPY apps/cli/package.json apps/cli/
COPY apps/web/package.json apps/web/
COPY apps/site/package.json apps/site/
COPY packages/shared/package.json packages/shared/tsconfig.json packages/shared/
COPY packages/container-runtime/package.json packages/container-runtime/tsconfig.json packages/container-runtime/
COPY packages/agent-adapters/package.json packages/agent-adapters/tsconfig.json packages/agent-adapters/
COPY packages/ticket-providers/package.json packages/ticket-providers/tsconfig.json packages/ticket-providers/
# mcp-bridge is built in the bridge stage above; its package.json is here so
# the frozen lockfile still matches the workspace graph.
COPY packages/mcp-bridge/package.json packages/mcp-bridge/

# Install production dependencies (--ignore-scripts avoids husky prepare hook)
RUN --mount=type=bind,from=pnpm-offline,target=/pnpm-offline,rw \
    if [ "$PNPM_OFFLINE" = "1" ]; then \
      pnpm install --frozen-lockfile --ignore-scripts \
        --offline --store-dir /pnpm-offline/store; \
    else pnpm install --frozen-lockfile --ignore-scripts; fi

# ---- Prebuildable third-party runtime toolchain ----
FROM ${NODE_SLIM_IMAGE} AS api-toolchain

ARG AGENT_CLIS=all
ARG CLAUDE_CODE_VERSION=2.1.112

# Verify Node ships OpenSSL >= 3.5 for post-quantum TLS (X25519MLKEM768)
RUN node -e 'const [maj,min] = process.versions.openssl.split(".").map(Number); if (maj < 3 || (maj === 3 && min < 5)) { console.error("OpenSSL " + process.versions.openssl + " too old; need >= 3.5"); process.exit(1); }'

# git + ca-certificates: required by the skill-sync worker for shallow-cloning
# marketplace skills (issue #497, Phase 2). python3 + curl: the run setup
# (WRITE_SETUP_FILES) and the harness commands of the work that runs in this
# pod (below).
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates python3 curl \
    && rm -rf /var/lib/apt/lists/*

# Install tsx globally for TypeScript execution at runtime
# (workspace packages export .ts source, so the API runs via tsx)
RUN npm install -g tsx

# The harnesses the Ask Optio assistant runs with in this pod by default
# (OPTIO_ASSISTANT_PLACEMENT=api-pod, services/assistant-placement.ts): the
# same Claude Code pin as the agent images (images/base.Dockerfile) and Codex.
# An assistant on another harness runs in an agent pod instead.
# TODO(#566): bump back to latest once upstream Bun ships a fix and claude-code adopts it.
# The API launches Codex with `codex exec --dangerously-bypass-approvals-and-
# sandbox` (task-worker.ts, pooled-agent-command.ts; `--full-auto` is gone
# from 0.162+): fail the build if the Codex this image gets no longer takes it.
RUN case ",${AGENT_CLIS}," in \
      *,all,*) npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" @openai/codex \
        && codex exec --help | grep -q -- --dangerously-bypass-approvals-and-sandbox ;; \
      *) case ",${AGENT_CLIS}," in *,claude-code,*) npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" ;; esac \
         && case ",${AGENT_CLIS}," in *,codex,*) npm install -g @openai/codex \
           && codex exec --help | grep -q -- --dangerously-bypass-approvals-and-sandbox ;; esac ;; \
    esac

# ---- Runtime stage ----
FROM ${API_TOOLCHAIN_IMAGE:-api-toolchain}

ARG OPTIO_VERSION=dev
ENV OPTIO_VERSION=${OPTIO_VERSION}

# The agent home every run writes under (/home/agent, as in the agent
# images): the assistant's run homes, setup files and harness config. The
# chart mounts an emptyDir here (the root filesystem is read-only).
RUN mkdir -p /home/agent && chown node:node /home/agent

# The MCP scripts an agent's .mcp.json names, at the path the agent images use.
RUN mkdir -p /opt/optio
COPY --from=bridge --chmod=0755 /app/packages/mcp-bridge/dist/mcp-bridge.js /opt/optio/mcp-bridge.js
COPY --from=bridge --chmod=0755 /app/packages/mcp-bridge/dist/controller-mcp.js /opt/optio/controller-mcp.js

WORKDIR /app

# Copy production dependencies from deps stage
COPY --from=deps /app/ ./

# Copy source
COPY packages/ packages/
COPY apps/api/ apps/api/

EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://localhost:4000/api/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

USER node

WORKDIR /app/apps/api
CMD ["tsx", "src/index.ts"]
