{
  "name": "optio",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/jonwiggins/optio.git"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "turbo dev --filter=@optio/api",
    "dev:web": "turbo dev --filter=@optio/web",
    "dev:site": "turbo dev --filter=@optio/site",
    "build": "turbo build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "turbo typecheck",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:push": "node scripts/check-push.mjs",
    "prepare": "husky",
    "gen:swift": "pnpm --filter @optio/shared gen:swift",
    "gen:kotlin": "pnpm --filter @optio/shared gen:kotlin"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,mjs}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "node-pty"
    ],
    "overrides": {
      "@grpc/grpc-js": "1.14.6",
      "@protobufjs/utf8": "1.1.2",
      "brace-expansion@>=2.0.0 <3.0.0": "2.1.7",
      "brace-expansion@>=5.0.0 <6.0.0": "5.0.12",
      "dompurify": "3.4.17",
      "esbuild": "0.28.2",
      "fast-uri": "3.1.9",
      "ip-address": "10.7.5",
      "postcss": "8.5.31",
      "protobufjs": "7.6.6",
      "uuid": "11.1.1",
      "ws": "8.22.0",
      "yaml": "2.9.1"
    }
  },
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=26.12.1 <27"
  }
}
